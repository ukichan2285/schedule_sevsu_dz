# Скопируйте в .env и заполните своими значениями.
# .env НЕ коммитится в git.

# Ссылка на .ics-календарь группы (настройки на schedule.sevsu.ru)
SCHEDULE_ICS_URL=https://schedule.sevsu.ru/calendar/group/ВАШ_ХЕШ

# Учебная группа
DEFAULT_GROUP=rs-s-26-1-o

# Частота автообновления расписания (в минутах)
UPDATE_INTERVAL_MINUTES=30

# На сколько недель вперёд хранить расписание
WEEKS_AHEAD=8

# Секретный ключ Flask
SECRET_KEY=change-me-to-random-string

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# Первый администратор (создаётся run.py)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_TELEGRAM_ID=

# База данных: DATABASE_URL (Postgres/Render) или SQLite-файл
DATABASE_URL=
SCHEDULE_DB_PATH=

# Прокси (при необходимости)
SCHEDULE_PROXY=
TELEGRAM_PROXY=

# Веб
PORT=5000
# 1 — режим разработки (автоперезапуск). На хостинге ставьте 0.
FLASK_DEBUG=1
